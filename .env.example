# 复制为 .env 后填写：cp .env.example .env
# docker compose 会自动读取同目录的 .env

# ---------- 访问 ----------
APP_PORT=8088
TZ=Asia/Shanghai
TIMEZONE=Asia/Shanghai

# ---------- WebDAV 源（必填） ----------
WEBDAV_BASE_URL=http://192.168.1.10:19798/dav/115/Media
WEBDAV_ROOT=动画
WEBDAV_USERNAME=your-account@example.com
WEBDAV_PASSWORD=your-password
# 大库/慢盘可加大
WEBDAV_TIMEOUT_MS=30000

# ---------- 取流方式 ----------
# proxy    后端转发，带 Basic 凭据，浏览器可直接播放（默认）
# redirect 302 直链，后端零带宽；目标地址需浏览器可直连
STREAM_MODE=proxy
# 直链前缀，留空则等于 WEBDAV_BASE_URL；可指向 CDN / 反代
# STREAM_URL_PREFIX=https://media.example.com/anime
# 直链追加的鉴权串（如 CDN token）
# STREAM_TOKEN=
# 直链时把账号密码拼进 URL（部分播放器需要，浏览器可能拦截）
# STREAM_EMBED_CREDENTIALS=false

# ---------- 索引 ----------
# auto | always | never
SCAN_ON_START=auto
# 自定义镜像地址（默认用预构建的 ghcr 镜像）
# IMAGE=ghcr.io/luvhx/anime-rotator:latest
