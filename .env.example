# 复制为 .env（可选）：cp .env.example .env
#
# 默认什么都不用填 —— 打开 http://<宿主机>:8088/admin 在界面里配置即可。
# 只有想改端口 / 时区，或用环境变量注入设置时才需要这个文件。

# 宿主机端口
APP_PORT=8088

# 容器时区
TZ=Asia/Shanghai

# ---- 以下为可选：用环境变量代替 Web UI 配置（环境变量只作为初始值，UI 保存后以 UI 为准） ----
# WEBDAV_BASE_URL=http://192.168.1.10:19798/dav/115/Media
# WEBDAV_ROOT=动画
# WEBDAV_USERNAME=your-account@example.com
# WEBDAV_PASSWORD=your-password
# STREAM_MODE=proxy
# STREAM_URL_PREFIX=https://media.example.com/anime
# SCAN_ON_START=auto
# ADMIN_PASSWORD=changeme
